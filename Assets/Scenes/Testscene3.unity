  m_Script: {fileID: 11500000, guid: 81d80a65c82da644086cc2e27bfe4592, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogue
  playerTransform: {fileID: 572216704}
  detectRadius: 50
  interactionPrompt: {fileID: 2049488356}
  spriteDown: {fileID: 21300000, guid: ccf0d0acbe3c3494f9273d99cb398ffc, type: 3}
  spriteUp: {fileID: 21300000, guid: ccf0d0acbe3c3494f9273d99cb398ffc, type: 3}
  spriteLeft: {fileID: 21300000, guid: adb90d8da5dbc214a8f2d9b6c6028231, type: 3}
  spriteRight: {fileID: 21300000, guid: ccf0d0acbe3c3494f9273d99cb398ffc, type: 3}
  defaultDirection: 0
  dialoguePanel: {fileID: 1113597711}
  dialogueText: {fileID: 1496207118}
  speakerNameText: {fileID: 1106202396}
  speakerName: Elias
  dialogueLines:
  - text: '"Kau kembali lagi... atau ini pertama kalinya kau ke sini?"'
    voiceClip: {fileID: 8300000, guid: 38f7878b98e9fbe479418214b0e2c4a7, type: 3}
  - text: '"Aku sudah mencatat semuanya. Setiap perubahan kecil di kebun ini."'
    voiceClip: {fileID: 8300000, guid: 08a263be413718048aa127d4b824f2bd, type: 3}
  - text: '"Tapi ingatanku sendiri... tidak selalu bisa dipercaya."'
    voiceClip: {fileID: 8300000, guid: 36926fcfdd888a44d9d658170577e68c, type: 3}
  - text: '"Kalau kau menemukan sesuatu yang aneh, catatlah. Jangan andalkan ingatanmu."'
    voiceClip: {fileID: 8300000, guid: e17c9513f53436f408c3830e48605e6b, type: 3}
  voiceAudioSource: {fileID: 1196732807}
  voiceVolume: 1
  stopVoiceOnNext: 1
  startKey: 19
  nextKey: 2
  autoStartOnApproach: 0
  showDebug: 0
